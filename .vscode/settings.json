{
  // Pinned, defaults included, per language where a setting allows it: VS Code merges these with each
  // person's own settings, objects key by key, so anything left out would let theirs change what a save
  // does or what the editor reports. Code actions are an empty list rather than an object for that reason.
  "[typescript]": {
    "editor.codeActionsOnSave": [],
    "js/ts.validate.enabled": true,
    "js/ts.preferences.importModuleSpecifier": "shortest",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": [],
    "js/ts.validate.enabled": true,
