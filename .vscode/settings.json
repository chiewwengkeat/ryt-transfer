  "[markdown]": {
    "editor.codeActionsOnSave": [],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false
  },
  "[yaml]": {
    "editor.codeActionsOnSave": [],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false
  },
  "prettier.enable": true,
  "prettier.configPath": "",
  "prettier.ignorePath": ".prettierignore",
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.useEditorConfig": true,
  "eslint.enable": true,
  "eslint.quiet": false,
  "eslint.rules.customizations": [],
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.nodePath": null,
  "eslint.nodeEnv": null,
  "eslint.useRealpaths": false,
  "eslint.onIgnoredFiles": "off",
  "eslint.bulkSuppression.enable": false,
  "eslint.options": {
    "allowInlineConfig": true,
    "baseConfig": null,
    "flags": [],
    "ignore": true,
    "ignorePatterns": null,
    "overrideConfig": null,
    "overrideConfigFile": null
  },
  "js/ts.experimental.useTsgo": false,
  "js/ts.implicitProjectConfig.checkJs": false,
  "js/ts.reportStyleChecksAsWarnings": false,
  "js/ts.tsserver.useSyntaxServer": "auto",
  "js/ts.preferences.organizeImports": {
    "caseSensitivity": "auto",
    "typeOrder": "auto",
    "unicodeCollation": "ordinal"
  },
  // Auto-import writes @/ where lint bans ../, and keeps ./ inside a folder, which "non-relative" would not.
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": ["^\\.\\.(/|$)"],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "i18n-ally.enabledFrameworks": ["react-i18next", "custom"],
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.localesPaths": ["src"],
  "i18n-ally.pathMatcher": "**/{namespace}/i18n/{locale}.json",
  // Left to guess, i18n-ally parses src's folder names as language tags, and "root" makes it stop loading.
  "i18n-ally.dirStructure": "file",
  "i18n-ally.namespace": true,
  // The approval modules are handed a transfer t, so no useTranslation in them names a namespace.
  "i18n-ally.defaultNamespace": "transfer",
  // i18n-ally looks up a plural's bare key, which only exists as _one and _other, so calls passing count or
  // defaultValue are left to the typed t, which checks them.
  "i18n-ally.regex.usageMatch": [
    "\\Wt\\(\\s*['\"`]({key})['\"`](?!\\s*,\\s*\\{[^}]*\\b(?:count|defaultValue)\\b)",
    "\\Wi18nKey=['\"`]({key})['\"`]"
  ],
  "i18n-ally.regex.usageMatchAppend": [],
  "i18n-ally.regex.key": "[\\w\\d\\. \\-\\[\\]\\/:]*?",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "en-MY",
  "i18n-ally.displayLanguage": "en-MY",
  "i18n-ally.disabled": false,
  "i18n-ally.includeSubfolders": true,
  "i18n-ally.disablePathParsing": false,
  "i18n-ally.ignoreFiles": [],
  "i18n-ally.ignoredLocales": [],
  "i18n-ally.languageTagSystem": "bcp47",
  "i18n-ally.encoding": "utf-8",
  "i18n-ally.extract.autoDetect": false
}
