{
  "name": "ryt-transfer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "android": "EXPO_PUBLIC_APP_VARIANT=development expo prebuild --clean --platform android && EXPO_PUBLIC_APP_VARIANT=development expo run:android",
    "android:demo": "EXPO_PUBLIC_APP_VARIANT=demo expo prebuild --clean --platform android && EXPO_PUBLIC_APP_VARIANT=demo expo run:android --variant release",
    "android:production": "EXPO_PUBLIC_APP_VARIANT=production expo prebuild --clean --platform android && EXPO_PUBLIC_APP_VARIANT=production expo run:android --variant release",
    "ios": "EXPO_PUBLIC_APP_VARIANT=development expo prebuild --clean --platform ios && EXPO_PUBLIC_APP_VARIANT=development expo run:ios",
    "ios:demo": "EXPO_PUBLIC_APP_VARIANT=demo expo prebuild --clean --platform ios && EXPO_PUBLIC_APP_VARIANT=demo expo run:ios --configuration Release",
    "ios:production": "EXPO_PUBLIC_APP_VARIANT=production expo prebuild --clean --platform ios && EXPO_PUBLIC_APP_VARIANT=production expo run:ios --configuration Release",
    "lint": "eslint . --max-warnings 0 && prettier --check . && node scripts/check-placement-ladder.js && secretlint \"**/*\"",
    "prepare": "husky",
    "start": "EXPO_PUBLIC_APP_VARIANT=development expo start",
    "test": "jest && node --test \"scripts/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@noble/curves": "2.4.0",
    "@sbaiahmed1/react-native-biometrics": "0.16.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.104.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-contacts": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "i18next": "26.4.2",
    "msw": "2.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-react/eslint-plugin": "5.24.6",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
